// Test profile: the whole pipeline on a bundled 409 kb genome, Zymoseptoria tritici
// IPO323 chromosome 21 (tests/test_data/README.md), fungus route. The genome path in
// the samplesheet is relative to the samplesheet, so the test runs from any directory.
//   nextflow run . -profile test,singularity -stub --outdir results_stub   # wiring only
//   nextflow run . -profile test,singularity --outdir results_test         # every tool

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Whole pipeline on Zymoseptoria tritici chromosome 21 (409 kb, fungus route)'

    // Resource caps for a laptop or a single cluster node
    max_cpus   = 4
    max_memory = '12.GB'
    max_time   = '6.h'

    // Input
    input            = "${projectDir}/assets/test_samplesheet.csv"
    outdir           = 'test_results'

    skip_visualization = false
}
