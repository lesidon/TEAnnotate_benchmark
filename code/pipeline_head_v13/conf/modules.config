// Per-module container, conda environment, and publishDir configuration.
// Containers are added here as each module is implemented.
//
// Container ⇄ Conda fallback: `container` and `conda` are dynamic closures that
// call the resolvers in nextflow.config (resolveContainer / resolveConda). Per
// task, exactly one returns non-null: the container is used when its image is
// cached or pullable, otherwise the task falls back to the Conda env. Disable
// with --container_fallback false; force Conda when offline with --assume_offline.

process {

    // ── INPUT_CHECK ───────────────────────────────────────────────────────────
    // Pure bash; no container needed beyond the Nextflow default. Deliberately
    // has no publishDir: its `genome` output is the unmodified input FASTA,
    // emitted only to gate downstream steps on validation. Publishing it copied
    // the whole genome into the outdir for no reason.

    // ── GENOME_STATS ──────────────────────────────────────────────────────────
    withName: 'GENOME_STATS' {
        container = { resolveContainer('quay.io/biocontainers/seqkit:2.8.0--h9ee0642_0', workflow.containerEngine) }
        conda     = { resolveConda('quay.io/biocontainers/seqkit:2.8.0--h9ee0642_0', 'bioconda::seqkit=2.8.0', workflow.containerEngine) }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/01_genome_stats" },
            mode: 'copy',
            pattern: '*.seqkit_stats.tsv'
        ]
    }

    // ── EARLGREY ──────────────────────────────────────────────────────────────
    // No biocontainers image for earl-grey; uses conda env as fallback.
    withName: 'EARLGREY' {
        conda = "${projectDir}/assets/environments/earl-grey.yml"
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/02_denovo_te/earlgrey" },
                mode: 'copy',
                pattern: '*.earlgrey_library.fa'
            ],
            [
                path: { "${params.outdir}/${meta.id}/02_denovo_te/earlgrey" },
                mode: 'copy',
                pattern: 'earlgrey_out/'
            ]
        ]
    }

    // ── HITE (de novo TE library, all organisms) ──────────────────────────────
    // Container-only: kanghu/hite:3.3.3 bundles the source (/HiTE) + all deps.
    // No usable Conda fallback (HiTE's env.yml has deps only, not the source).
    // --writable-tmpfs: HiTE's bundled tools (RepeatMasker etc.) may write inside
    // the read-only image.
    // kanghu/hite:3.3.3 lacks bin/FiLTR-main/bin/LtrDetector/bin/, so HiTE's default
    // LTR step finds nothing; HITE_LTRDETECTOR builds that directory and HITE runs
    // from a linked copy of /HiTE that uses it (no bind mount, so every engine works).
    withName: 'HITE_LTRDETECTOR' {
        conda = 'conda-forge::git'
    }
    withName: 'HITE' {
        container        = { resolveContainer('kanghu/hite:3.3.3', workflow.containerEngine) }
        containerOptions = { workflow.containerEngine in ['singularity','apptainer'] ? '--writable-tmpfs' : '' }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/02_denovo_te/hite" },
            mode: 'copy',
            pattern: '*.{hite_library.fa,hite_status.tsv}'
        ]
    }

    // ── EDTA (de novo TE library, plant route) ────────────────────────────────
    // Prefer the biocontainer (the EDTA Conda solve is very heavy); fall back to
    // bioconda::edta only when no container engine is available. --writable-tmpfs:
    // EDTA's bundled RepeatMasker/RepeatModeler may write inside the read-only image.
    withName: 'EDTA' {
        container        = { resolveContainer('quay.io/biocontainers/edta:2.3.0--hdfd78af_0', workflow.containerEngine) }
        conda            = { resolveConda('quay.io/biocontainers/edta:2.3.0--hdfd78af_0', 'bioconda::edta=2.3.0', workflow.containerEngine) }
        containerOptions = { workflow.containerEngine in ['singularity','apptainer'] ? '--writable-tmpfs' : '' }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/02_denovo_te/edta" },
            mode: 'copy',
            pattern: '*.edta_library.fa'
        ]
    }

    // ── HELIANO (dedicated Helitron detection, plant route) ───────────────────
    // Conda-only (bioconda::heliano; no container image published).
    withName: 'HELIANO' {
        conda = "${projectDir}/assets/environments/heliano.yml"
        publishDir = [
            path: { "${params.outdir}/${meta.id}/02_denovo_te/heliano" },
            mode: 'copy',
            pattern: '*.heliano_library.fa'
        ]
    }

    // ── STARFISH_ANNOTATE ─────────────────────────────────────────────────────
    // Starfish (Starship-element annotation; Hartwick et al. / egluckthaler) is
    // NOT the bioconda "starfish" package (that is the CZI spatial-transcriptomics
    // library). It is published on the `egluckthaler` conda channel and as an ORAS
    // Apptainer image.
    //
    // We run it from a Conda env (NOT the ORAS image): that image uses a busybox-style
    // shell whose internal conda activation is incompatible with Nextflow's task
    // wrapper — `.command.sh` never executes (the body produces no output and the
    // task exits 1). No `conda` or `container` directive on purpose: the task builds
    // (once, cached) or reuses the env itself and runs on the host shell, so a failed
    // build only skips the report. A `conda` directive here would make Nextflow build
    // the env, and a failed build would abort the whole run (tested 2026-10-21).
    withName: 'STARFISH_ANNOTATE' {
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/02_denovo_te/starfish" },
                mode: 'copy',
                pattern: '*.starfish_captains.tsv'
            ],
            [
                path: { "${params.outdir}/${meta.id}/02_denovo_te/starfish" },
                mode: 'copy',
                pattern: '*_starfish'
            ]
        ]
    }

    // ── CAT_TE_LIBRARIES ──────────────────────────────────────────────────────
    withName: 'CAT_TE_LIBRARIES' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/02_denovo_te" },
            mode: 'copy',
            pattern: '*.{raw_library.fa,provenance.tsv}'
        ]
    }

    // ── CD_HIT_EST (Stage 2 — dedup/merge) ────────────────────────────────────
    // Conda-only (like EARLGREY): cd-hit's env is tiny and solves fast, avoiding
    // any biocontainers tag mismatch. Add a container resolver later if desired.
    // Time: CD-HIT-EST with the 80-80-80 local-alignment settings scales badly with
    // long consensi and uses few of its threads; on ~11,000 rice consensi it ran past
    // the 1-day process_medium limit. The library-stage steps on the whole library
    // (CD-HIT, refinement, evidence gate) therefore get the process_high time.
    // MMseqs2 (+ python for bin/mmseqs_to_clstr.py) for libraries of at least
    // --dedup_mmseqs_min_seqs sequences.
    withName: 'CD_HIT_EST' {
        conda = 'bioconda::cd-hit=4.8.1 bioconda::mmseqs2=18.8cc5c conda-forge::python=3.11'
        time  = { check_max( 72.h * task.attempt, 'time' ) }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/03_library" },
            mode: 'copy',
            pattern: '*.{dedup_library.fa*,lineage.tsv}'
        ]
    }

    // ── DEDUP_REFINE (Stage 2 — class-aware repair of the CD-HIT clusters) ────
    // Needs python3 + blastn: the TEtrimmer image carries both (and is pulled anyway).
    withName: 'DEDUP_REFINE' {
        container = { resolveContainer('quay.io/biocontainers/tetrimmer:1.7.2--hdfd78af_0', workflow.containerEngine) }
        conda     = { resolveConda('quay.io/biocontainers/tetrimmer:1.7.2--hdfd78af_0', 'bioconda::blast=2.16.0 conda-forge::python=3.11', workflow.containerEngine) }
        time      = { check_max( 72.h * task.attempt, 'time' ) }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/03_library" },
            mode: 'copy',
            pattern: '*.{refined_library.fa,dedup_refine.tsv,refined_lineage.tsv}'
        ]
    }

    // ── TE_EVIDENCE (Stage 2 — evidence gate) ─────────────────────────────────
    // TEsorter + blastn + python3 (+ ps for Nextflow) are all in the TEsorter image.
    withName: 'TE_EVIDENCE' {
        container = { resolveContainer('quay.io/biocontainers/tesorter:1.5.1--pyhdfd78af_0', workflow.containerEngine) }
        conda     = { resolveConda('quay.io/biocontainers/tesorter:1.5.1--pyhdfd78af_0', 'bioconda::tesorter=1.5.1 bioconda::blast=2.16.0', workflow.containerEngine) }
        time      = { check_max( 72.h * task.attempt, 'time' ) }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/03_library" },
            mode: 'copy',
            pattern: '*.{gated_library.fa,evidence.tsv,non_te_repeats.fa,gate_removed.fa}'
        ]
    }

    // ── DOMAIN_RELABEL (Stage 3 — domain-label check of curated consensi) ──────
    withName: 'DOMAIN_RELABEL' {
        container = { resolveContainer('quay.io/biocontainers/tesorter:1.5.1--pyhdfd78af_0', workflow.containerEngine) }
        conda     = { resolveConda('quay.io/biocontainers/tesorter:1.5.1--pyhdfd78af_0', 'bioconda::tesorter=1.5.1 bioconda::blast=2.16.0', workflow.containerEngine) }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/04_curation" },
            mode: 'copy',
            pattern: '*.domain_relabel.tsv'
        ]
    }

    // ── Stage 3, --curation_class_aware: TEtrimmer output -> class-aware merge ──
    // TETRIMMER_POSTPROCESS re-checks labels of TEtrimmer's un-merged consensi; the
    // Stage 2 CD-HIT + refine steps then replace TEtrimmer's length-based merge.
    withName: 'TETRIMMER_POSTPROCESS' {
        container = { resolveContainer('quay.io/biocontainers/tetrimmer:1.7.2--hdfd78af_0', workflow.containerEngine) }
        conda     = { resolveConda('quay.io/biocontainers/tetrimmer:1.7.2--hdfd78af_0', 'bioconda::blast=2.16.0 conda-forge::python=3.11', workflow.containerEngine) }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/04_curation" },
            mode: 'copy',
            pattern: '*.{tetrimmer_postprocess.tsv,tetrimmer_lineage.tsv}'
        ]
    }
    // An alias also matches its base name's selector ('CD_HIT_EST' above), so every
    // directive that must differ, publishDir included, is set again here.
    withName: 'CD_HIT_EST_CURATED' {
        conda      = 'bioconda::cd-hit=4.8.1 bioconda::mmseqs2=18.8cc5c conda-forge::python=3.11'
        time       = { check_max( 72.h * task.attempt, 'time' ) }
        ext.prefix = { "${meta.id}.curated" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/04_curation" },
            mode: 'copy',
            pattern: '*.{dedup_library.fa*,lineage.tsv}'
        ]
    }
    withName: 'DEDUP_REFINE_CURATED' {
        container  = { resolveContainer('quay.io/biocontainers/tetrimmer:1.7.2--hdfd78af_0', workflow.containerEngine) }
        conda      = { resolveConda('quay.io/biocontainers/tetrimmer:1.7.2--hdfd78af_0', 'bioconda::blast=2.16.0 conda-forge::python=3.11', workflow.containerEngine) }
        time       = { check_max( 72.h * task.attempt, 'time' ) }
        ext.prefix = { "${meta.id}.curated" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/04_curation" },
            mode: 'copy',
            pattern: '*.{refined_library.fa,dedup_refine.tsv,refined_lineage.tsv}'
        ]
    }

    // ── PFAM_FETCH (Stage 3 — Pfam-A for TEtrimmer) ───────────────────────────
    // Downloads + hmmpress-indexes Pfam-A with Conda-provided curl + hmmer, cached
    // via storeDir. NOT errorStrategy 'ignore': PFAM is mandatory for TEtrimmer, so
    // a failure must stop the run (the user can supply --pfam_db instead).
    withName: 'PFAM_FETCH' {
        conda = 'bioconda::hmmer conda-forge::curl'
    }

    // ── TETRIMMER (Stage 3 — curation) ────────────────────────────────────────
    // Prefer the biocontainer (the Conda solve is heavy and was being killed,
    // exit 143, during env creation). Falls back to the tetrimmer.yml Conda env
    // only when no container engine/image is available (e.g. --assume_offline).
    withName: 'TETRIMMER' {
        container = { resolveContainer('quay.io/biocontainers/tetrimmer:1.7.2--hdfd78af_0', workflow.containerEngine) }
        conda     = { resolveConda('quay.io/biocontainers/tetrimmer:1.7.2--hdfd78af_0', "${projectDir}/assets/environments/tetrimmer.yml", workflow.containerEngine) }
        // TEtrimmer chmods its bundled /usr/local/share/tetrimmer/TE-Aid-master at
        // startup, which fails on the read-only Singularity image. An overlay
        // tmpfs makes the container filesystem writable in-memory (Docker is
        // writable already, so the flag is Singularity/Apptainer-only).
        //
        // --writable-tmpfs is NOT enough on every cluster: it needs overlay support, and
        // an unprivileged Singularity without a setuid path uses "underlay" mode, where
        // the flag is accepted and then dropped —
        //   WARNING: Disabling --writable-tmpfs as it can't be used in conjunction with underlay
        // — leaving the image read-only and TEtrimmer dying on Errno 30. Set
        // --tetrimmer_teaid_dir <host dir with a writable copy of TE-Aid-master> to bind
        // over that path instead; a bind mount is writable whatever the overlay support.
        // Read via containsKey: a bare params access inside a directive closure can
        // resolve before the params block binds (see dlContainerImage in nextflow.config).
        containerOptions = {
            if (!(workflow.containerEngine in ['singularity','apptainer'])) return ''
            def teaid = params.containsKey('tetrimmer_teaid_dir') ? params.tetrimmer_teaid_dir : null
            def opts  = ['--writable-tmpfs']
            if (teaid) opts << "--bind ${teaid}:/usr/local/share/tetrimmer/TE-Aid-master"
            return opts.join(' ')
        }
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/04_curation" },
                mode: 'copy',
                pattern: '*.curated_library.fa'
            ],
            [
                path: { "${params.outdir}/${meta.id}/04_curation" },
                mode: 'copy',
                pattern: '*_tetrimmer/'
            ]
        ]
    }

    // ── TECLASS2_CLONE / TECLASS2_FETCH_MODEL (Stage 3 setup) ─────────────────
    // Fetch the TEclass2 source + model at run time. git / curl are provided via
    // tiny Conda envs so they don't depend on the host PATH (HPC nodes often hide
    // git behind `module load`). errorStrategy 'ignore' makes the whole TEclass2
    // path non-fatal: if a fetch fails (no git/curl, offline, dead URL), the run
    // continues and CURATION falls back to the curated (non-reclassified) library.
    withName: 'TECLASS2_CLONE' {
        conda         = 'conda-forge::git'
        errorStrategy = 'ignore'
    }
    withName: 'TECLASS2_FETCH_MODEL' {
        conda         = 'conda-forge::curl'
        errorStrategy = 'ignore'
    }

    // ── TECLASS2 (Stage 3 — DL classification) ────────────────────────────────
    // Transformer-based classifier (IOB-Muenster/TEclass2). Conda-only (no
    // bioconda/registry image; see the module header). GPU vs CPU is selected
    // inside via the config `device` key (cuda when --use_gpu). On a scheduler,
    // add `label 'process_gpu'` (accelerator + gpu_queue routing) for GPU nodes.
    // errorStrategy 'ignore': a classifier failure must not abort the pipeline —
    // CURATION falls back to the curated library for that sample.
    withName: 'TECLASS2' {
        container     = { resolveContainer(dlContainerImage('teclass2_container'), workflow.containerEngine) }
        conda         = { resolveConda(dlContainerImage('teclass2_container'), "${projectDir}/assets/environments/teclass2.yml", workflow.containerEngine) }
        errorStrategy = 'ignore'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/05_classification" },
            mode: 'copy',
            pattern: '*.{teclass2.preds.tsv,teclass2.tsv}'
        ]
    }

    // ── DeepTE (Stage 3 — ensemble member; CNN, organism-aware) ───────────────
    withName: 'DEEPTE_CLONE' {
        conda         = 'conda-forge::git'
        errorStrategy = 'ignore'
    }
    withName: 'DEEPTE_FETCH_MODEL' {
        conda         = 'conda-forge::curl'
        errorStrategy = 'ignore'
    }
    withName: 'DEEPTE' {
        container     = { resolveContainer(dlContainerImage('deepte_container'), workflow.containerEngine) }
        conda         = { resolveConda(dlContainerImage('deepte_container'), "${projectDir}/assets/environments/deepte.yml", workflow.containerEngine) }
        errorStrategy = 'ignore'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/05_classification" },
            mode: 'copy',
            pattern: '*.{deepte.preds.tsv,deepte.txt}'
        ]
    }

    // ── CREATE (Stage 3 — ensemble member; attention CNN+RNN, Wicker) ─────────
    // Source cloned with Conda-provided git; models fetched from Google Drive via
    // Conda-provided gdown (handles Drive's large-file confirm token). The classifier
    // env builds TensorFlow via pip (assets/environments/create.yml). All three are
    // errorStrategy 'ignore' so a fetch/run failure just makes CREATE abstain.
    withName: 'CREATE_CLONE' {
        conda         = 'conda-forge::git'
        errorStrategy = 'ignore'
    }
    withName: 'CREATE_FETCH_MODEL' {
        conda         = 'conda-forge::gdown'
        errorStrategy = 'ignore'
    }
    withName: 'CREATE' {
        container     = { resolveContainer(dlContainerImage('create_container'), workflow.containerEngine) }
        conda         = { resolveConda(dlContainerImage('create_container'), "${projectDir}/assets/environments/create.yml", workflow.containerEngine) }
        errorStrategy = 'ignore'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/05_classification" },
            mode: 'copy',
            pattern: '*.{create.preds.tsv,create.relabeled.fasta}'
        ]
    }

    // ── NeuralTE (Stage 3 — ensemble member; CNN, RepeatMasker labels) ────────
    withName: 'NEURALTE_CLONE' {
        conda         = 'conda-forge::git'
        errorStrategy = 'ignore'
    }
    withName: 'NEURALTE' {
        container     = { resolveContainer(dlContainerImage('neuralte_container'), workflow.containerEngine) }
        conda         = { resolveConda(dlContainerImage('neuralte_container'), "${projectDir}/assets/environments/neuralte.yml", workflow.containerEngine) }
        errorStrategy = 'ignore'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/05_classification" },
            mode: 'copy',
            pattern: '*.{neuralte.preds.tsv,neuralte.info}'
        ]
    }

    // ── Terrier (Stage 3 — ensemble member; PyTorch, RepeatMasker labels) ─────
    withName: 'TERRIER' {
        container     = { resolveContainer(dlContainerImage('terrier_container'), workflow.containerEngine) }
        conda         = { resolveConda(dlContainerImage('terrier_container'), "${projectDir}/assets/environments/terrier.yml", workflow.containerEngine) }
        errorStrategy = 'ignore'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/05_classification" },
            mode: 'copy',
            pattern: '*.{terrier.preds.tsv,terrier.csv}'
        ]
    }

    // ── EXTRACT_UNKNOWN (Stage 3 — subset Unknown consensi for the ensemble) ──
    withName: 'EXTRACT_UNKNOWN' {
        conda = 'conda-forge::python=3.10'
    }

    // ── ENSEMBLE_VOTE (Stage 3 — majority-rule re-classification) ─────────────
    withName: 'ENSEMBLE_VOTE' {
        conda = 'conda-forge::python=3.10'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/05_classification" },
            mode: 'copy',
            pattern: '*.{classified_library.fa,voting_table.tsv}'
        ]
    }

    // ── FINAL_LIBRARY — the library masking uses, on every route ──────────────
    withName: 'FINAL_LIBRARY' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/05_classification" },
            mode: 'copy',
            pattern: '*.te_library.fa'
        ]
    }

    // ── Single-pass RepeatMasker masking (Stage 3) ───────────────────────────
    // One RepeatMasker run over the original genome with the curated library and
    // built-in simple/low-complexity detection left ON, so the .tbl reports simple +
    // interspersed together. -xsmall soft-masks; -a writes the .align for the Kimura
    // landscape. The .out is split into simple/TE/combined GFF3. Biocontainer preferred,
    // bioconda::repeatmasker fallback. --writable-tmpfs: RepeatMasker writes config /
    // library files inside its (read-only) install dir on Singularity/Apptainer images.
    // RepeatMasker can fail transiently while building its general libraries inside the
    // container; the module now exits non-zero on any RepeatMasker failure, so retry it
    // (twice: this also keeps base.config's resource-scaling retries for OOM).
    withName: 'REPEATMASKER' {
        container        = { resolveContainer('dfam/tetools:1.89.2', workflow.containerEngine) }
        conda            = { resolveConda('dfam/tetools:1.89.2', 'bioconda::repeatmasker=4.1.5', workflow.containerEngine) }
        containerOptions = { workflow.containerEngine in ['singularity','apptainer'] ? '--writable-tmpfs' : '' }
        errorStrategy    = 'retry'
        maxRetries       = 2
        publishDir = [
            path: { "${params.outdir}/${meta.id}/06_masking" },
            mode: 'copy',
            pattern: '*.{softmasked.fa,repeats.tbl,repeats.out,repeats.align,repeats.bed,repeats.gff3,simple.gff3,te.gff3}'
        ]
    }

    // ── Stage 4: Visualization & QC ───────────────────────────────────────────
    // CALC_DIVERGENCE reuses the RepeatMasker image (calcDivergenceFromAlign.pl); the
    // three plotting steps run R (ggplot2) via rocker/tidyverse, with a conda-forge R
    // fallback. Each figure and the R script that drew it publish to visualization/.
    // ── RIP_SCAN (fungal genomes; stdlib-only Python, the masking image has python3)
    withName: 'RIP_SCAN' {
        container = { resolveContainer('dfam/tetools:1.89.2', workflow.containerEngine) }
        conda     = { resolveConda('dfam/tetools:1.89.2', 'conda-forge::python=3.11', workflow.containerEngine) }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/06_masking" },
            mode: 'copy',
            pattern: '*.rip_*'
        ]
    }
    withName: 'CALC_DIVERGENCE' {
        container        = { resolveContainer('dfam/tetools:1.89.2', workflow.containerEngine) }
        conda            = { resolveConda('dfam/tetools:1.89.2', 'bioconda::repeatmasker=4.1.5', workflow.containerEngine) }
        containerOptions = { workflow.containerEngine in ['singularity','apptainer'] ? '--writable-tmpfs' : '' }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/07_visualization" },
            mode: 'copy',
            pattern: '*.{divsum,kimura_matrix.tsv}'
        ]
    }
    // NOTE: publishDir takes a LIST of directive maps for multiple patterns. Two
    // separate `publishDir =` assignments do NOT accumulate — the second overwrites
    // the first — which previously dropped every figure and published only the .R script.
    withName: 'PLOT_KIMURA' {
        container = { resolveContainer('rocker/tidyverse:4.3.2', workflow.containerEngine) }
        conda     = { resolveConda('rocker/tidyverse:4.3.2', 'conda-forge::r-base=4.3 conda-forge::r-ggplot2 conda-forge::r-ragg conda-forge::r-svglite', workflow.containerEngine) }
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/07_visualization" },
                mode: 'copy',
                pattern: '*.kimura_landscape*.{png,svg,pdf}'
            ],
            [
                path: { "${params.outdir}/${meta.id}/07_visualization" },
                mode: 'copy',
                pattern: 'plot_kimura.R'
            ]
        ]
    }
    withName: 'PLOT_KARYOTYPE' {
        container = { resolveContainer('rocker/tidyverse:4.3.2', workflow.containerEngine) }
        conda     = { resolveConda('rocker/tidyverse:4.3.2', 'conda-forge::r-base=4.3 conda-forge::r-ggplot2 conda-forge::r-ragg conda-forge::r-svglite', workflow.containerEngine) }
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/07_visualization" },
                mode: 'copy',
                pattern: '*.{karyoplot.png,karyoplot.svg,karyoplot.pdf,karyoplot_density.tsv,karyoplot_lengths.tsv}'
            ],
            [
                path: { "${params.outdir}/${meta.id}/07_visualization" },
                mode: 'copy',
                pattern: 'plot_karyotype.R'
            ]
        ]
    }
    withName: 'REPEAT_QC' {
        container = { resolveContainer('rocker/tidyverse:4.3.2', workflow.containerEngine) }
        conda     = { resolveConda('rocker/tidyverse:4.3.2', 'conda-forge::r-base=4.3 conda-forge::r-ggplot2 conda-forge::r-ragg conda-forge::r-svglite', workflow.containerEngine) }
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/07_visualization" },
                mode: 'copy',
                pattern: '*.{repeat_qc_composition.png,repeat_qc_composition.svg,repeat_qc_composition.pdf,repeat_qc_summary.tsv,repeat_qc_composition.tsv}'
            ],
            [
                path: { "${params.outdir}/${meta.id}/07_visualization" },
                mode: 'copy',
                pattern: 'repeat_qc.R'
            ]
        ]
    }

}
