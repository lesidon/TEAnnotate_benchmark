// De novo TE library construction with EDTA (Extensive de novo TE Annotator).
// EDTA is the plant-standard library builder: it runs LTRharvest/LTR_retriever,
// TIR-Learner, HelitronScanner and Generic Repeat Finder, then filters them into
// one non-redundant, classified consensus library. Library-only mode (--anno 0):
// no whole-genome RepeatMasker annotation. Generic plant model (--species others).
//
// Sequence IDs longer than 13 characters are renamed for the run (LTR_retriever
// limit; see the script) and restored in the library.
//
// Prefer the biocontainer (the Conda solve is heavy/slow); fall back to
// bioconda::edta only when no container engine is available. --writable-tmpfs:
// EDTA's bundled tools (RepeatMasker etc.) may write inside the read-only image.
process EDTA {
    tag "$meta.id"
    label 'process_high'

    input:
    tuple val(meta), path(genome)

    output:
    tuple val(meta), path("${meta.id}.edta_library.fa"), emit: library
    path 'versions.yml'                                , emit: versions

    script:
    """
    # \$HOME on this HPC is read-only from inside the container; redirect HOME and
    # caches to the (writable) task work dir for RepeatMasker/matplotlib/etc.
    export HOME="\$PWD"
    export MPLCONFIGDIR="\$PWD/.mplconfig"
    export XDG_CACHE_HOME="\$PWD/.cache"
    mkdir -p "\$MPLCONFIGDIR" "\$XDG_CACHE_HOME"

    # TIR-Learner 3.0.1 as bundled with EDTA 2.3.0 does not run under the image's
    # pandas 3: it crashes (x[0] on a labelled row -> KeyError: 0; chromosome IDs
    # with dots, e.g. NC_003070.9, never map back from their '<id>_split_NofM' chunks
    # -> KeyError; and on large genomes (chicken, mouse, zebra finch) the per-sequence
    # step that cuts candidate sequences runs swifter inside multiprocessing workers:
    # swifter first applies the lambda to a whole sample (TypeError), then falls back to
    # dask, which cannot fork in a daemonic worker -> "daemonic processes are not allowed
    # to have children"; that step uses a plain row-wise pandas apply instead). EDTA then
    # skips HelitronScanner too. Run a patched copy: EDTA finds TIR-Learner with
    # `command -v TIR-Learner`, so a wrapper first on PATH suffices.
    # The edits apply only where the buggy lines are present.
    TL_WRAPPER=\$(command -v TIR-Learner || true)
    TL_SRC=\$(grep -oE '/[^ ]*TIR-Learner[^ /]*\\.py' "\${TL_WRAPPER:-/dev/null}" 2>/dev/null | head -1 || true)
    if [[ -n "\${TL_SRC}" && -f "\${TL_SRC}" ]]; then
        mkdir -p tirlearner/bin
        cp -r "\$(dirname "\${TL_SRC}")" tirlearner/TIR-Learner
        sed -i 's/^\\(\\s*\\)family = x\\[0\\]\$/\\1family = x.iloc[0]/' tirlearner/TIR-Learner/bin/check_TIR_TSD.py
        sed -i 's/id_pattern = r"^(\\\\w+)_split_/id_pattern = r"^(\\\\S+?)_split_/' tirlearner/TIR-Learner/bin/run_GRF.py
        sed -i -e 's/genome_SeqRecord\\.seq\\[x\\["start"\\]: x\\["end"\\]\\]/genome_SeqRecord.seq[int(x["start"]): int(x["end"])]/' \\
               -e 's/df\\["seq"\\] = df\\.swifter\\.progress_bar(flag_verbose)\\.apply(/df["seq"] = df.apply(/' \\
               tirlearner/TIR-Learner/bin/get_fasta_sequence.py
        printf '#!/bin/bash\\npython3 %s "\$@"\\n' "\$PWD/tirlearner/TIR-Learner/\$(basename "\${TL_SRC}")" > tirlearner/bin/TIR-Learner
        chmod +x tirlearner/bin/TIR-Learner
        export PATH="\$PWD/tirlearner/bin:\$PATH"
    else
        echo "WARN [${meta.id}]: TIR-Learner source not found; running it unpatched" >&2
    fi

    # EDTA's redundancy filter cleanup_nested.pl (final library; stage-1 TIR/Helitron
    # library) runs threads with a race: two near-identical copies blasted at the same
    # time each delete the other, so multi-copy (mostly LTR) families vanish at random
    # (Zymoseptoria tritici: a 13 kb Gypsy and a 6 kb Copia, ~1 Mb of LTR). Run EDTA
    # from a work-dir copy (database linked, not copied) whose cleanup_nested.pl applies
    # each query's edits under a lock and skips a query that another thread already
    # changed or removed. EDTA's scripts find their helpers via FindBin, so every stage
    # uses the copy. (the bioconda EDTA.pl is a wrapper: perl /usr/local/share/EDTA/EDTA.pl)
    EDTA_BIN=\$(command -v EDTA.pl)
    EDTA_DIR=\$(grep -oE '/[^ ]*/EDTA/' "\${EDTA_BIN}" 2>/dev/null | head -1 || true)
    [[ -d "\${EDTA_DIR}database" ]] || EDTA_DIR="\$(dirname "\$(readlink -f "\${EDTA_BIN}")")/"
    EDTA_CMD=(EDTA.pl)
    if [[ -f "\${EDTA_DIR}EDTA.pl" && -f "\${EDTA_DIR}bin/cleanup_nested.pl" ]]; then
        rm -rf edta_src && mkdir edta_src
        for f in "\${EDTA_DIR}"*; do
            case "\$(basename "\$f")" in
                database|test) ln -s "\$f" edta_src/ ;;
                *)             cp -r "\$f" edta_src/ ;;
            esac
        done
        chmod -R u+w edta_src
        sed -i '/# removing the regions from the subject that are inserted into the query/a lock(%seq); next if !exists \$seq{\$id} or \$touched_seq{\$id};' edta_src/bin/cleanup_nested.pl
        if grep -q '^lock(%seq); next if' edta_src/bin/cleanup_nested.pl; then
            EDTA_CMD=(perl "\$PWD/edta_src/EDTA.pl")
        else
            echo "WARN [${meta.id}]: cleanup_nested.pl not patched (unexpected EDTA version); running EDTA unpatched" >&2
        fi
    else
        echo "WARN [${meta.id}]: EDTA scripts not found under '\${EDTA_DIR}'; running EDTA unpatched" >&2
    fi

    # LTR_retriever (bundled with EDTA 2.3.0) renames the genome to <genome>.mod with
    # IDs cut to 13 characters whenever any sequence ID is longer, whatever EDTA asks.
    # EDTA only shortens IDs itself when they would overflow rmblastn's 50-character
    # limit, which depends on scaffold length, so e.g. 14-character accessions on
    # chromosome-length sequences (NW_025061564.1, OENG01000318.1) pass EDTA untouched;
    # LTR_retriever then writes every result under the renamed prefix, EDTA finds no
    # pass.list ("LOC list - is empty"), reports 0 bp of LTR and falls back to rice.
    # Give EDTA IDs of at most 13 characters (edtaid<N>) and map them back afterwards.
    EDTA_IN=${genome}
    MAXID=\$(awk '/^>/{ l = length(\$1) - 1; if (l > m) m = l } END { print m + 0 }' ${genome})
    if (( MAXID > 13 )); then
        awk '/^>/{ n++; print "edtaid" n "\\t" substr(\$1, 2) > "edta_seqid.map"; print ">edtaid" n; next } { print }' ${genome} > edta_input.fa
        EDTA_IN=edta_input.fa
        echo "INFO [${meta.id}]: sequence IDs up to \${MAXID} characters; EDTA runs on IDs edtaid<N> (edta_seqid.map)" >&2
    fi

    # --force 1: continue when a sub-module finds no TEs instead of aborting. EDTA then
    # copies its bundled RICE library for that module, which must never reach the
    # output: that is checked right after the run. The log is kept for that check.
    set -o pipefail
    "\${EDTA_CMD[@]}" \\
        --genome \${EDTA_IN} \\
        --species others \\
        --step all \\
        --anno 0 \\
        --force 1 \\
        --threads ${task.cpus} \\
        --overwrite 0 2>&1 | tee edta_run.log

    # Final non-redundant, classified library: <genome>.mod.EDTA.TElib.fa
    LIB=\$(find . -name '*.mod.EDTA.TElib.fa' -print -quit 2>/dev/null || true)

    # Rice fallback (--force 1): a module's raw file is then a verbatim copy of
    # <EDTA>/database/rice7.0.0.liban.<TYPE>. A module that crashed (a Python traceback
    # or a fatal signal in the log; e.g. TIR-Learner, which also stops HelitronScanner)
    # fails the task: its TEs are missing, not absent. A module that ran and found
    # nothing (e.g. no SINEs in a fungus: "The SINE result file has 0 bp!") is a real
    # result; the rice sequences EDTA substituted for it are removed from the library
    # (>= 80% identity over >= 50% of a library sequence to that rice library).
    EDTA_DB="\${EDTA_DIR}database"
    [[ -d "\${EDTA_DB}" ]] || echo "WARN [${meta.id}]: EDTA database dir not found; rice-fallback check skipped" >&2
    RICE_USED=""
    for t in LTR:LTR.raw.fa LINE:LINE.raw.fa SINE:SINE.raw.fa TIR:TIR.intact.raw.fa Helitron:Helitron.intact.raw.fa; do
        RAW=\$(find . -maxdepth 2 -path '*.EDTA.raw/*' -name "*.mod.\${t#*:}" -print -quit)
        RICE="\${EDTA_DB}/rice7.0.0.liban.\${t%%:*}"
        if [[ -n "\${RAW}" && -s "\${RICE}" ]] && cmp -s "\${RAW}" "\${RICE}"; then
            RICE_USED="\${RICE_USED} \${t%%:*}"
        fi
    done
    if [[ -n "\${RICE_USED}" ]]; then
        if grep -qE 'Traceback \\(most recent call last\\)|Segmentation fault|core dumped' edta_run.log; then
            echo "ERROR [${meta.id}]: EDTA substituted its bundled RICE library for\${RICE_USED} (--force 1) after a module crashed." >&2
            echo "  See the traceback in .command.log; the TEs of that module are missing, not absent." >&2
            exit 1
        fi
        echo "WARN [${meta.id}]: EDTA found no\${RICE_USED} candidates (no module crashed); the rice sequences it substituted are removed from the library." >&2
        if [[ -n "\${LIB}" && -s "\${LIB}" ]]; then
            for t in \${RICE_USED}; do cat "\${EDTA_DB}/rice7.0.0.liban.\${t}"; done > rice_substituted.fa
            makeblastdb -in rice_substituted.fa -dbtype nucl -out rice_substituted > /dev/null
            blastn -query "\${LIB}" -db rice_substituted -perc_identity 80 -evalue 1e-10 -dust no \\
                -outfmt '6 qseqid qlen qstart qend' -num_threads ${task.cpus} > rice_hits.tsv
            # library sequences covered >= 50% by rice hits (merged intervals)
            sort -k1,1 -k3,3n rice_hits.tsv | awk '
                function flush() { if (q != "" && (cov + e - s + 1) >= 0.5 * len) print q }
                \$1 != q { flush(); q = \$1; len = \$2; cov = 0; s = \$3; e = \$4; next }
                \$3 > e  { cov += e - s + 1; s = \$3; e = \$4; next }
                \$4 > e  { e = \$4 }
                END { flush() }' > rice_removed.ids
            awk 'NR == FNR { drop[\$1] = 1; next }
                 /^>/ { id = substr(\$1, 2); keep = !(id in drop) }
                 keep' rice_removed.ids "\${LIB}" > edta_norice.fa
            echo "INFO [${meta.id}]: \$(grep -c . rice_removed.ids) of \$(grep -c '^>' "\${LIB}") library sequences matched the substituted rice library and were removed" >&2
            LIB=edta_norice.fa
        fi
    fi

    if [[ -n "\${LIB}" && -s "\${LIB}" && -s edta_seqid.map ]]; then
        # consensus names can carry genome coordinates: restore the original IDs
        awk 'NR == FNR { id[\$1] = \$2; next }
             /^>/ { s = \$0; out = ""
                    while (match(s, /edtaid[0-9]+/)) {
                        k = substr(s, RSTART, RLENGTH)
                        out = out substr(s, 1, RSTART - 1) ((k in id) ? id[k] : k)
                        s = substr(s, RSTART + RLENGTH) }
                    \$0 = out s }
             { print }' edta_seqid.map "\${LIB}" > ${meta.id}.edta_library.fa
    elif [[ -n "\${LIB}" && -s "\${LIB}" ]]; then
        cp "\${LIB}" ${meta.id}.edta_library.fa
    else
        echo "WARN [${meta.id}]: EDTA produced no TElib.fa" >&2
        touch ${meta.id}.edta_library.fa
    fi

    EDTA_VER=\$(ls "\${CONDA_PREFIX:-}"/conda-meta/edta-*.json /usr/local/conda-meta/edta-*.json 2>/dev/null | sed -E 's@.*/edta-([0-9][^-]*)-.*@\\1@' | head -1 || true)
    [[ -z "\${EDTA_VER}" ]] && EDTA_VER=2.3.0
    cat <<-END_VERSIONS > versions.yml
    "${task.process}":
        edta: \${EDTA_VER}
    END_VERSIONS
    """

    stub:
    """
    cat > ${meta.id}.edta_library.fa <<-EOF
    >TE_00000001_stub#LTR/Gypsy
    GGCTAGCGGCTAGCGGCTAGCGGCTAGCGGCTAGCGGCTAGCGGCTAGCGGCTAGCGGCT
    EOF

    cat <<-END_VERSIONS > versions.yml
    "${task.process}":
        edta: "stub"
    END_VERSIONS
    """
}
