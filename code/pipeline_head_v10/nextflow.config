manifest {
    name            = 'nf-core/teannotate'
    author          = ''
    homePage        = 'https://github.com/nf-core/teannotate'
    description     = 'End-to-end transposable element and tandem repeat annotation'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0dev'
}

// ── Default parameters ────────────────────────────────────────────────────────
params {

    // ── Input / output ─────────────────────────────────────────────────────────
    input                       = null
    outdir                      = './results'

    // ── Organism routing ───────────────────────────────────────────────────────
    organism_type               = 'animal'      // plant | animal | fungus (default: animal)
    assembly_quality            = 'auto'        // auto | draft | chromosome | T2T
    // Auto-tier thresholds (genome-size-aware; see bin/assess_assembly_quality.py).
    // An assembly is chromosome-scale if EITHER rule holds:
    chromosome_n50_mb           = 10            //   absolute: contig N50 ≥ this many Mb.
    chromosome_n50_fraction     = 0.05          //   relative: N50 ≥ this × genome size (and ≥ 1 Mb).
                                                //   Rescues compact genomes (e.g. fungi); the relative
                                                //   rule covers organisms with up to ~1/fraction chromosomes.

    // ── De novo TE discovery engines ──────────────────────────────────────────
    // HiTE (full-length LTR/TIR/Helitron/non-LTR) runs alongside Earl Grey on
    // every genome and its library is merged before dedup. Container-only
    // (kanghu/hite). Disable with --skip_hite.
    skip_hite                   = false

    // ── User-supplied TE consensus library ────────────────────────────────────
    user_te_library             = null          // optional FASTA path

    // ── Starship (Starfish) annotation — fungal, opt-in ───────────────────────
    run_starfish                = false         // Starfish needs a heavy egluckthaler
                                                //   Conda env whose solver can be OOM-killed
                                                //   (exit 137) and abort the run. Opt-in:
                                                //   enable with --run_starfish (ideally also
                                                //   --use_mamba). Still requires a per-genome GFF.

    // ── CD-HIT-EST deduplication (library merge) ──────────────────────────────
    cdhit_identity              = 0.80
    cdhit_coverage              = 0.80
    // CD-HIT keeps each cluster's longest sequence with its own label, so a family of
    // another class collapsed into it is lost. DEDUP_REFINE relabels Unknown
    // representatives from their classified members and rescues foreign-class members.
    dedup_class_aware           = true
    dedup_split_chimeras        = true          // all-vs-all blastn: cut segments of another
                                                //   TE class out of chimeric consensi
    dedup_rep_by_copies         = false         // EXPERIMENTAL, off: cluster representative = member
                                                //   with the most full-length genomic copies. Harmful
                                                //   in LTR-rich genomes: an LTR terminus clusters with
                                                //   its element and, having the most copies, replaces it
    // Replace TEtrimmer's own length-based merge with the class-aware one above, and
    // relabel consensi TEtrimmer rebuilt from an element of another class.
    curation_class_aware        = true
    // After TEtrimmer, a consensus whose TE domains point to another class than its
    // label takes the domain class (e.g. a HELIANO "Helitron" with a Gypsy RT).
    curation_domain_relabel     = true

    // ── Evidence gate (TE_EVIDENCE, after dedup) ──────────────────────────────
    // A consensus is kept on evidence of being a TE: a TE protein domain (TEsorter),
    // the same element in another discovery tool's library, or >= 2 full-length
    // genomic copies. 'lite' drops non-TE repeats (Satellite, rRNA, ... -> separate
    // file) and consensi with none of these; 'strict' also drops those whose only
    // evidence is full-length copies; 'off' skips the step.
    evidence_gate               = 'lite'
    evidence_relabel_unknown    = true          // Unknown + TE domain -> the domain's class
    evidence_pfam               = true          // also count TE-specific Pfam domains (six-frame ORFs);
                                                //   REXdb's clade profiles miss divergent TEs of
                                                //   unexplored lineages. Uses the Pfam-A of TEtrimmer.
    evidence_tesorter_db        = 'rexdb'       // TEsorter HMM database (rexdb covers plants + metazoa)
    evidence_support_identity   = 80            // % identity for cross-tool support
    evidence_support_coverage   = 0.5           // fraction of the consensus another tool must cover
    evidence_min_full_copies    = 2             // full-length copies (>=75% id over >=90%)
    evidence_min_half_copies    = 5             // or copies covering >=50% (>=70% id): old families
                                                //   keep partial copies only (RIP: extreme in fungi);
                                                //   0 = full-length copies only
    // TEtrimmer keeps a skipped input only with >= 2 full-length copies; bring back
    // inputs it left no consensus for when they carry a TE domain or cross-tool support.
    tetrimmer_reinject          = true

    // ── Consensus TR filter (pre-curation ejection of TR-dominated consensi) ──
    consensus_tr_threshold      = 0.90          // fraction of consensus covered by TRF-mod
    consensus_tr_min_length     = 200           // bp; only apply filter to consensi >= this length

    // Tandem-repeat annotation is not a separate stage: single-pass RepeatMasker (Stage 3
    // masking, subworkflows/local/masking) detects simple/tandem/satellite AND interspersed
    // repeats in one run, so both land in the same .tbl. Disable with --skip_masking.

    // ── Curation (Stage 3) — TEtrimmer PFAM database ───────────────────────────
    // TEtrimmer REQUIRES Pfam-A to orient TEs and aborts curation without it; its
    // built-in downloader fails on locked-down HPC nodes, so the pipeline fetches +
    // hmmpress-indexes Pfam once (curl, cached) and hands it over via --pfam_dir.
    // Set --pfam_db to a pre-downloaded local dir (containing Pfam-A.hmm[.h3*] and
    // Pfam-A.hmm.dat) to skip the ~1.5 GB download entirely.
    pfam_db                     = null
    // TEtrimmer chmods its bundled TE-Aid install at startup (TEtrimmer.py ->
    // change_permissions_recursive), which fails on a read-only container image with
    //   OSError: [Errno 30] Read-only file system: '/usr/local/share/tetrimmer/TE-Aid-master'
    // --writable-tmpfs normally makes the image writable, but it needs OVERLAY support:
    // an unprivileged Singularity with no setuid path falls back to "underlay" mode and
    // silently drops the flag ("WARNING: Disabling --writable-tmpfs as it can't be used
    // in conjunction with underlay"). Point this at a host directory holding a WRITABLE
    // COPY of the image's TE-Aid-master and it is bind-mounted over that path instead —
    // a bind is writable regardless of overlay/underlay. Populate it once with:
    //   mkdir -p "$DIR"
    //   singularity exec -B "$(dirname $DIR)":/mnt <tetrimmer.img> \
    //       cp -r /usr/local/share/tetrimmer/TE-Aid-master/. "/mnt/$(basename $DIR)/"
    //   chmod -R u+rwX "$DIR"
    tetrimmer_teaid_dir         = null
    // kanghu/hite:3.3.3 ships without bin/FiLTR-main/bin/LtrDetector/bin/ (the LtrDetector
    // binary its default LTR step runs), so HiTE would silently find NO LTR families.
    // HITE_LTRDETECTOR fetches that directory from the HiTE commit the image code
    // matches (hite_revision), cached under hite_cache; HiTE checks it runs before
    // discovery starts. hite_ltrdetector_dir: a prebuilt directory instead (offline
    // hosts; see the README recipe).
    hite_ltrdetector_dir        = null
    hite_repo_url               = 'https://github.com/CSU-KangHu/HiTE.git'
    hite_revision               = '03c2e7790ef1d3ec9e95098927a7befbfe9dce1b'
    hite_cache                  = "${launchDir}/hite_cache"
    // Ablation: skip TEtrimmer and send the deduplicated de novo library straight to
    // re-classification (its Unknown fraction still goes through the ensemble).
    skip_tetrimmer              = false
    // Fetched assets are pinned (Pfam release, source commits below) and cached per
    // identity: the cache directory is named after the release / commit / URL, so a
    // changed value downloads into its own directory instead of reusing the old one.
    // Each cached asset carries a source.tsv (requested and resolved identity, checksum).
    pfam_cache                  = "${launchDir}/pfam_cache"
    pfam_hmm_url                = 'https://ftp.ebi.ac.uk/pub/databases/Pfam/releases/Pfam38.2/Pfam-A.hmm.gz'
    pfam_dat_url                = 'https://ftp.ebi.ac.uk/pub/databases/Pfam/releases/Pfam38.2/Pfam-A.hmm.dat.gz'

    // ── TE re-classification (Stage 3) — DL classifier ensemble ────────────────
    // Runs BY DEFAULT: the kingdom's classifiers (ensemble_models_<kingdom>) each
    // classify the curated library's "Unknown" fraction independently, and
    // ENSEMBLE_VOTE assigns the class. The default strategy is the TWO-STEP vote: an
    // Order vote, then a superfamily vote inside the winning Order, each with its own
    // per-kingdom weights (bin/ensemble_vote.py TWO_STEP_DEFAULTS, tuned on
    // leakage-filtered curated consensi). The older single-step rules remain as
    // --ensemble_method weighted / hard; --ensemble_method all writes every column.
    // Skip the whole ensemble with --skip_reclassification, or drop a member with
    // --skip_teclass2 / --skip_deepte / --skip_create / --skip_neuralte / --skip_terrier.
    // Each tool has no bioconda/registry image or redistributable license, so its
    // source + model are fetched and cached at run time (needs internet on the
    // clone/download node — true for the local executor on a login node). Override
    // *_repo / *_model to pre-stage.
    skip_reclassification       = false         // master switch (off = ensemble runs)
    ensemble_method             = 'two_step'    // 'two_step' (default) | 'weighted' | 'hard' | 'all'
                                                //   ('catboost' lives on an experimental branch)
    ensemble_two_step_config    = null          // JSON overriding the built-in two-step settings,
                                                //   e.g. {"fungus": {"order": {"weights": {...}}}}
    ensemble_relabel_orders     = 'DNA,RC'      // Orders the ensemble may assign; other calls leave
                                                //   the consensus Unknown. The Unknowns that reach it
                                                //   lack a detectable coding domain: plausible for
                                                //   non-autonomous TIR elements / Helitrons, while
                                                //   LTR / LINE calls on them were mostly wrong on the
                                                //   development genomes. 'all' = no restriction.
    // The options below apply to the single-step 'weighted' / 'hard' rules only.
    ensemble_min_frac           = 0.5           // abstention gate: the winning class must carry this
                                                //   fraction of what the VOTING SUBSET could maximally
                                                //   cast. Scales with the subset, so it works for the
                                                //   5-model set (=> 3-of-5 votes / 3.3 weight) and for
                                                //   a single-model subset (=> 1 vote) alike.
                                                //   0 = no gate (plain argmax). See bin/ensemble_vote.py.
    ensemble_min_votes          = 0             // hard voting: optional ABSOLUTE floor on agreeing
                                                //   votes, on top of ensemble_min_frac. 0 = off.
    ensemble_min_agree          = 2             // a relabel needs >= this many models of the voting
                                                //   subset on the winning Order. NOT relaxed for small
                                                //   subsets: a single-model subset (fungus = Terrier)
                                                //   relabels nothing. 0 = off.
    ensemble_min_weight         = 0             // weighted voting: optional ABSOLUTE floor on summed
                                                //   weight, on top of ensemble_min_frac. 0 = off.
                                                //   NB an absolute floor is subset-blind: 3.0 is a sane
                                                //   bar for all five models (max 6.6) but unreachable
                                                //   for fungus (max 1.5), which would mute the stage.
                                                //   Prefer ensemble_min_frac; a floor the subset cannot
                                                //   reach is ignored with a warning.
    ensemble_weights            = null          // override weights, e.g.
                                                //   'neuralte=1.5,terrier=1.5,create=1.3,teclass2=1.2,deepte=1.1'
                                                //   (null = built-in defaults that prioritise NeuralTE/Terrier)
    ensemble_weights_from       = null          // derive weights from an order-level metrics TSV
                                                //   (evaluate_classification *.all_models.summary_metrics.tsv)
    ensemble_weight_metric      = 'macro_f1'    // metric column used with ensemble_weights_from

    // Kingdom-aware ensemble: only the model subset per organism_type RUNS and votes.
    // The defaults are the models the two-step settings use (selected on the train
    // split of leakage-filtered PanTEon/MycoMobilome consensi; DeepTE was never
    // chosen). All models that ran appear in the voting table. For weighted / hard,
    // ensemble_min_frac is resolved against the subset's own maximum weight.
    // Set ensemble_kingdom_aware = false to run all enabled models everywhere (the
    // two-step vote still uses only the models with a two-step weight).
    ensemble_kingdom_aware      = true
    ensemble_models_animal      = 'teclass2,neuralte,terrier'
    ensemble_models_plant       = 'teclass2,create,neuralte,terrier'
    ensemble_models_fungus      = 'create,neuralte,terrier'

    // Per-tool container images for the DL classifiers, published on GHCR (public).
    // The resolver (bottom of this file) prefers the image under a container profile
    // and silently falls back to the Conda env (assets/environments/*.yml) when the
    // engine is absent (-profile conda) or the registry is unreachable offline. Each
    // image ships the tool's env as a conda env named after the tool at
    // /opt/conda/envs/<tool>; the modules put that env's bin on PATH (a read-only .sif
    // cannot use `micromamba run`). Override with a local .sif for a fully offline run
    // (e.g. --teclass2_container /abs/path/teannotate-teclass2.sif), or set to null to
    // force the Conda env.
    teclass2_container          = 'oras://ghcr.io/lesidon/teannotate-teclass2:1.0'
    create_container            = 'oras://ghcr.io/lesidon/teannotate-create:1.0'
    deepte_container            = 'oras://ghcr.io/lesidon/teannotate-deepte:1.0'
    neuralte_container          = 'oras://ghcr.io/lesidon/teannotate-neuralte:1.0'
    terrier_container           = 'oras://ghcr.io/lesidon/teannotate-terrier:1.0'

    // TEclass2 (Transformer)
    skip_teclass2               = false
    teclass2_repo_url           = 'https://github.com/IOB-Muenster/TEclass2.git'
    teclass2_revision           = '612470ea42ee1b9897406c18967e8b7558775dac'  // git commit / tag / branch
    teclass2_model_url          = 'https://bioinformatics.uni-muenster.de/tools/teclass2/models/teclass2-models.tgz'
    teclass2_cache              = "${launchDir}/teclass2_cache"  // storeDir for fetched assets
    teclass2_repo               = null          // override: existing TEclass2 clone dir (skips clone)
    teclass2_model              = null          // override: existing extracted model dir (skips download)
    teclass2_checkpoint         = null          // override: checkpoint path under the model dir
    teclass2_min_score          = 0.7           // top-class prob below this -> abstain (stays Unknown).
                                                //   0.7 keeps only confident votes (low-prob calls added
                                                //   noise that hurt the ensemble). Set 0 to never abstain.
    use_gpu                     = false         // Run GPU-capable steps on a GPU. Adds Singularity
                                                //   --nv; TEclass2 selects cuda vs cpu from this.

    // DeepTE (CNN, organism-aware: -sp / model chosen from organism_type)
    skip_deepte                 = false
    deepte_repo_url             = 'https://github.com/LiLabAtVT/DeepTE.git'
    deepte_revision             = '1f76ff9da6e1dbfbb771868cdd0e149ec41457a2'
    deepte_model_url_plants     = 'https://de.cyverse.org/dl/d/89D2FE7A-41BA-4F64-80E2-B9C26D49E99F/Plants_model.tar.gz'
    deepte_model_url_metazoans  = 'https://de.cyverse.org/dl/d/441459EF-6DDD-41A5-A9AB-1D5D13049F18/Metazoans_model.tar.gz'
    deepte_model_url_fungi      = 'https://de.cyverse.org/dl/d/8B112733-063A-4DE9-89EC-22A062D8807B/Fungi_model.tar.gz'
    deepte_model_url_others     = 'https://de.cyverse.org/dl/d/34CF8ACB-0B1F-4210-8359-366A70539F01/Others_model.tar.gz'
    deepte_cache                = "${launchDir}/deepte_cache"
    deepte_repo                 = null          // override: existing DeepTE clone dir
    deepte_model                = null          // override: existing extracted models dir

    // CREATE (attention-based CNN+RNN; Wicker taxonomy). Source cloned + models
    // fetched from Google Drive (via gdown) at run time. TensorFlow is pip-installed
    // inside the conda env (assets/environments/create.yml), keeping the heavy DL
    // stack out of the conda solver (the failure mode that made TERL unsolvable).
    skip_create                 = false
    create_repo_url             = 'https://github.com/yangqi-cs/CREATE.git'
    create_revision             = '4f686b61d87783063f0877970c2471e034641b24'
    create_model_gdrive_id      = '1OWzmD5sMM7kAJjKmq0LS3HibqzNVFThe'  // Google Drive model.tar.gz
    create_prob_thr             = 0.70          // -p: per-node probability threshold. 0.70 matches the
                                                //   shared confidence cut-off used by every probability-
                                                //   emitting model (TEclass2/Terrier); set 0 to always
                                                //   descend to the arg-max leaf.
    create_cache                = "${launchDir}/create_cache"
    create_repo                 = null          // override: existing CREATE clone dir
    create_model                = null          // override: existing extracted model dir

    // NeuralTE (CNN; RepeatMasker labels via --is_wicker 0). Source AND its in-repo
    // pre-trained model are cloned at run time (NEURALTE_CLONE) and cached.
    skip_neuralte               = false
    neuralte_repo_url           = 'https://github.com/CSU-KangHu/NeuralTE.git'
    neuralte_revision           = '18e99a9d4ca4d5dc6cf1fcdbc1a4968d0cb6b22e'
    neuralte_cache              = "${launchDir}/neuralte_cache"
    neuralte_repo               = null          // override: existing NeuralTE clone dir

    // Terrier (PyTorch/corgi; RepeatMasker labels). pip package `bio-terrier`; the
    // model weights auto-download (and are baked into the container image), so there
    // is no repo/model to fetch.
    skip_terrier                = false
    terrier_min_prob            = 0.70          // abstain if the arg-max class prob is below this
                                                //   (0.70 = the shared cut-off across all probability-
                                                //   emitting models: TEclass2, CREATE, Terrier)
    terrier_use_gpu             = false         // Terrier runs on CPU by default even under --use_gpu,
                                                //   because its image's Torch often needs a newer CUDA
                                                //   driver than the node has (crashes on load/predict).
                                                //   Set true only where the driver is new enough.

    // ── Genome masking (Stage 3, final) — single-pass RepeatMasker ─────────────
    // One RepeatMasker run over the original genome with the classified library and
    // built-in simple/low-complexity detection ON, so simple/tandem/satellite AND
    // interspersed repeats land in the same .tbl. -xsmall soft-masks; -a writes the
    // .align used by the Stage 4 Kimura landscape. The .out is split into simple / TE /
    // combined GFF3. Disable the whole stage with --skip_masking.
    skip_masking                = false

    // ── Visualization ─────────────────────────────────────────────────────────
    skip_visualization          = false
    substitution_rate           = null          // null = organism-aware auto-select
    kimura_faceted              = false         // false = single stacked area (default)
    karyoplot_window_kb         = 500
    plot_formats                = 'png,svg'

    // ── HPC scheduler options ─────────────────────────────────────────────────
    // Passed to every process via closures in conf/base.config.
    // Combine with a scheduler profile: -profile singularity,slurm
    queue                       = null  // Default queue/partition for all jobs.
                                        //   SLURM: --partition  PBS: -q  LSF: -q  SGE: -q
    gpu_queue                   = null  // Separate GPU partition (process_gpu label).
                                        //   Falls back to params.queue when null.
    clusterOptions              = null  // Extra raw scheduler directives, e.g.:
                                        //   SLURM: '--account=proj --reservation=r1'
                                        //   PBS:   '-A proj -l walltime=72:00:00'
                                        //   LSF:   '-P proj'
    singularity_cache_dir       = null  // Path to shared .sif image cache directory.
                                        //   Set this to a Lustre/GPFS path so images
                                        //   are pulled once and reused across runs.
                                        //   Can also be set via $NXF_SINGULARITY_CACHEDIR.
                                        //   STRONGLY recommended for the DL images: run
                                        //   bin/prepull_containers.sh once into this dir
                                        //   so the flaky ORAS/GHCR pull never happens
                                        //   mid-run (a pull failure is fatal — it is
                                        //   raised during task staging, so errorStrategy
                                        //   'ignore' cannot catch it).
    singularity_pull_timeout    = '60 min'  // Max time for a SINGLE image pull. Raised
                                        //   from Nextflow's 20-min default because the DL
                                        //   images are multi-GB. NB: does NOT fix ORAS
                                        //   'stream error ... PROTOCOL_ERROR' (an HTTP/2
                                        //   failure, not a timeout) — pre-pull for that.
    conda_cachedir              = null  // Path to shared conda environments cache.
                                        //   Set to a Lustre/GPFS path so envs are
                                        //   built once and reused: --conda_cachedir /scratch/conda
                                        //   Can also be set via $NXF_CONDA_CACHEDIR.
    auto_bind_ps                = true  // Auto-detect the host `ps` (+ its procps library)
                                        //   and bind it into every Singularity/Apptainer
                                        //   container, so Nextflow's task-metric collector
                                        //   always has a working `ps` even in images that ship
                                        //   a missing/broken one (e.g. rocker/tidyverse ->
                                        //   "libprocps.so.4 not found"). Detection runs on the
                                        //   driver host at config time (under the local executor
                                        //   the driver IS the compute node). Set false to disable.
    host_ps                     = null  // Force a specific host `ps` binary to bind (absolute
                                        //   path). Overrides auto-detection; normally unneeded.

    // ── Dynamic container ⇄ Conda fallback ────────────────────────────────────
    // When a container engine is active, each containerised process prefers its
    // container and silently falls back to a Conda environment when the image is
    // neither cached locally (.sif/.img) nor pullable from a registry. See the
    // resolver helpers at the bottom of this file.
    container_fallback          = true  // false = pure profile switching, no auto-fallback.
    assume_offline              = false // true = assume no registry; force Conda for
                                        //   any image not already in the .sif cache.
                                        //   Skips the network reachability probe.
                                        //   (Named assume_offline, not offline, because
                                        //    -offline is a core Nextflow CLI option.)
    container_registry_probe    = 'quay.io'  // Host probed once (HEAD /v2/) to decide
                                        //   whether uncached images can still be pulled.
    use_mamba                   = false // Solve Conda envs with mamba instead of conda —
                                        //   faster and far less memory, avoiding the OOM
                                        //   (exit 137) seen on heavy envs like Starfish.
                                        //   Requires mamba on PATH. Applies to the conda
                                        //   and singularity (conda-fallback) profiles.

    // ── Max resource limits (enforced in conf/base.config) ────────────────────
    max_memory                  = '128.GB'
    max_cpus                    = 32
    max_time                    = '72.h'

    // ── nf-core / nf-schema generic options ───────────────────────────────────
    help                        = false
    help_full                   = false
    show_hidden                 = false
    monochrome_logs             = false
    validate_params             = true
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
}

// ── Config inclusions ─────────────────────────────────────────────────────────
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Building an environment the first time can exceed Nextflow's 20-minute default
// (Earl Grey's took longer on a cluster file system); a timeout kills the build.
conda.createTimeout = '2 h'

// ── Profiles ──────────────────────────────────────────────────────────────────
profiles {

    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }

    conda {
        conda.enabled           = true
        conda.cacheDir          = params.conda_cachedir ?: null
        conda.useMamba          = params.use_mamba
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
    }

    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        conda.cacheDir          = params.conda_cachedir ?: null
        docker.enabled          = false
        singularity.enabled     = false
    }

    // Docker / Podman: images for every step that has one, plus Conda for the steps
    // that have none (EARLGREY, CD_HIT_EST, PFAM_FETCH, EXTRACT_UNKNOWN, ENSEMBLE_VOTE)
    // and for the DL classifiers, whose oras:// images only Singularity/Apptainer can
    // pull. Conda must therefore be installed on the host, as for -profile singularity.
    docker {
        docker.enabled          = true
        conda.enabled           = true
        conda.cacheDir          = params.conda_cachedir ?: null
        conda.useMamba          = params.use_mamba
        singularity.enabled     = false
        podman.enabled          = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        // --nv exposes host NVIDIA GPUs to the container when --use_gpu is set.
        // Harmless if the node has no GPU (the tool then runs on CPU).
        // hostPsBindOpts() auto-detects the host `ps` (+ its procps library) and binds
        // it in, so Nextflow's task-metric collector always has a working `ps` even in
        // images that ship a missing/broken one (see the helper at the foot of this file).
        singularity.runOptions  = ([ (params.use_gpu ? '--nv' : ''), hostPsBindOpts() ]
                                    .findAll { it }.join(' ')).trim()
        // cacheDir: pre-pulled .sif files are stored here and reused.
        // On HPC, point this at a shared Lustre/GPFS path via:
        //   --singularity_cache_dir /scratch/shared/singularity
        // or by setting $NXF_SINGULARITY_CACHEDIR in your environment.
        singularity.cacheDir    = params.singularity_cache_dir ?: null
        // Large multi-GB DL images can exceed the 20-minute default pull window.
        singularity.pullTimeout = params.singularity_pull_timeout
        // Both engines are enabled on purpose. conda.enabled = true provides the
        // *fallback* runtime: every containerised process declares its `container`
        // and `conda` as mutually-exclusive dynamic closures (conf/modules.config),
        // so Conda is only ever built for a process whose image is unavailable —
        // and for EARLGREY, which has no container image at all. No per-process
        // conda-nulling is needed; the resolvers guarantee exactly one runtime.
        conda.enabled           = true
        conda.cacheDir          = params.conda_cachedir ?: null
        conda.useMamba          = params.use_mamba
        docker.enabled          = false
        podman.enabled          = false
    }

    // ── HPC job scheduler profiles ────────────────────────────────────────────
    // Combine with a container profile:
    //   nextflow run . -profile singularity,slurm --queue normal --clusterOptions '--account=proj'

    slurm {
        process.executor         = 'slurm'
        executor.queueSize       = 100
        executor.submitRateLimit = '10 sec'
    }

    pbs {
        process.executor         = 'pbs'
        executor.queueSize       = 100
        executor.submitRateLimit = '5 sec'
    }

    lsf {
        process.executor         = 'lsf'
        executor.queueSize       = 100
        executor.submitRateLimit = '10 sec'
    }

    sge {
        process.executor         = 'sge'
        // smp is the standard parallel environment for multi-core SGE jobs;
        // override with --clusterOptions '-pe mpi 16' if your cluster differs.
        process.penv             = 'smp'
        executor.queueSize       = 100
        executor.submitRateLimit = '10 sec'
    }

    podman {                    // same hybrid as docker (see above)
        podman.enabled          = true
        conda.enabled           = true
        conda.cacheDir          = params.conda_cachedir ?: null
        conda.useMamba          = params.use_mamba
        docker.enabled          = false
        singularity.enabled     = false
    }

    test      { includeConfig 'conf/test.config' }
}

// ── nf-schema plugin ──────────────────────────────────────────────────────────
plugins {
    id 'nf-schema@2.2.0'
}

validation {
    defaultIgnoreParams         = ['genomes', 'pipelines_testdata_base_path']
    monochromeLogs              = params.monochrome_logs
    help {
        enabled                 = true
        command                 = "nextflow run . --help"
        fullParameter           = "help_full"
        showHiddenParameter     = "show_hidden"
    }
}

// ── Executor defaults (applies when any HPC scheduler profile is active) ─────
// Individual scheduler profiles override queueSize / submitRateLimit as needed.
executor {
    queueSize           = 100   // Max concurrent jobs submitted to the scheduler.
                                // Increase for very large sample sets.
    submitRateLimit     = '10 sec'  // Submission rate limit — protects scheduler.
    exitReadTimeout     = '10 min'  // How long to wait for scheduler job-exit status.
    pollInterval        = '2 min'   // How often Nextflow polls scheduler for status.
}

// ── Execution reports ─────────────────────────────────────────────────────────
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}

// ── Shell defaults ────────────────────────────────────────────────────────────
process.shell = ['/bin/bash', '-euo', 'pipefail']

// ── Dynamic container ⇄ Conda fallback resolvers ──────────────────────────────
// Used inside the `container`/`conda` directive closures in conf/modules.config.
// Each containerised process passes its image, its Conda spec, and the active
// engine (workflow.containerEngine); exactly one of the two resolvers returns a
// non-null value, so the task runs in a container when one is usable and falls
// back to a Conda environment otherwise. The engine is passed in (rather than
// read here) because `workflow` is reliably in scope inside the directive
// closure, mirroring the standard nf-core `container "${workflow.containerEngine
// == 'singularity' ? ... }"` idiom.

// Replicates Nextflow's SingularityCache.simpleName(): strip the URL protocol,
// then replace ':' and '/' with '-'. Nextflow appends '.img' (or '.sif') to this.
def singularityCacheName(String image) {
    def name = image
    int p = name.indexOf('://')
    if (p != -1) name = name.substring(p + 3)
    return name.replace(':', '-').replace('/', '-')
}

// True if a pre-pulled image for `image` already exists in the Singularity cache
// (params.singularity_cache_dir or $NXF_SINGULARITY_CACHEDIR / $SINGULARITY_CACHEDIR).
def sifCached(String image) {
    def dir = params.singularity_cache_dir ?:
              System.getenv('NXF_SINGULARITY_CACHEDIR') ?:
              System.getenv('SINGULARITY_CACHEDIR')
    if (!dir) return false
    def cacheDir = new File(dir.toString())
    if (!cacheDir.isDirectory()) return false
    def base = singularityCacheName(image)
    if (new File(cacheDir, "${base}.img").exists()) return true
    if (new File(cacheDir, "${base}.sif").exists()) return true
    // Defensive: match any cached file beginning with the derived base name, to
    // absorb Nextflow-version differences in the appended extension.
    return cacheDir.listFiles()?.any { it.name.startsWith(base) } ?: false
}

// Single, memoised connectivity probe to a container registry. The result is
// cached in a JVM system property, so the network is touched at most once per run.
def registryReachable() {
    if (params.assume_offline) return false
    def cached = System.getProperty('teannotate.registry.reachable')
    if (cached != null) return cached == 'true'
    boolean reachable = false
    try {
        def host = params.container_registry_probe ?: 'quay.io'
        def conn = new URL("https://${host}/v2/").openConnection()
        conn.connectTimeout = 3000
        conn.readTimeout    = 3000
        conn.requestMethod  = 'HEAD'
        conn.responseCode   // any HTTP response (even 401 Unauthorized) ⇒ reachable
        reachable = true
    } catch (Exception e) {
        reachable = false   // DNS failure / connection refused / timeout ⇒ offline
    }
    System.setProperty('teannotate.registry.reachable', reachable.toString())
    return reachable
}

// Core decision: is a usable container available for this image right now?
def containerAvailable(String image, String engine) {
    if (!image)  return false                     // no image (e.g. --*_container null) ⇒ Conda
    if (!engine) return false                     // no engine (e.g. -profile conda) ⇒ Conda
    boolean singularityLike = engine in ['singularity', 'apptainer']
    // A local image file (.sif/.img) that exists on disk is directly usable, even
    // offline — no registry probe needed (e.g. --deepte_container /path/img.sif).
    if (singularityLike && (image.endsWith('.sif') || image.endsWith('.img')) &&
        new File(image).isFile()) return true
    // oras:// images are Singularity/Apptainer-only — Docker/Podman cannot pull
    // them — so treat them as unavailable there and let the Conda fallback win.
    if (image.startsWith('oras://') && !singularityLike) return false
    if (!singularityLike)           return true   // Docker/Podman: let the engine pull as usual
    if (!params.container_fallback) return true   // fallback disabled ⇒ always use the container
    if (sifCached(image))           return true   // already pulled locally ⇒ use it
    return registryReachable()                    // uncached ⇒ usable only if we can pull it
}

// Companion resolvers wired into the directive closures in conf/modules.config.
// Parameters are intentionally untyped: Nextflow invokes config functions
// reflectively, and reflection will not coerce a GString (e.g. a
// "${projectDir}/...yml" conda path) to a String parameter — that throws
// "argument type mismatch". So we accept any value and coerce with toString().
def resolveContainer(image, engine) {
    def img = image?.toString()
    containerAvailable(img, engine?.toString()) ? img : null
}
def resolveConda(image, condaSpec, engine) {
    containerAvailable(image?.toString(), engine?.toString()) ? null : condaSpec?.toString()
}

// DL-classifier image lookup. Nextflow evaluates the `container`/`conda` directive closures
// (conf/modules.config) EARLY — before the params-block defaults are bound into the config
// `params` — so a bare `params.<tool>_container` there logs "Access to undefined parameter"
// AND resolves to null, which silently drops the image and forces the Conda fallback. (The
// publishDir closures don't hit this because they evaluate post-task, once params are bound;
// EDTA/EarlGrey don't because they pass a literal image string.) `containsKey` never warns,
// and the fallback keeps the correct image when the key isn't bound yet. An explicit
// `--<tool>_container null` still wins (the key is present, value null -> Conda).
// NB: keep these defaults in sync with the params block above and nextflow_schema.json.
def dlContainerImage(String name) {
    def fallback = [
        teclass2_container: 'oras://ghcr.io/lesidon/teannotate-teclass2:1.0',
        create_container  : 'oras://ghcr.io/lesidon/teannotate-create:1.0',
        deepte_container  : 'oras://ghcr.io/lesidon/teannotate-deepte:1.0',
        neuralte_container: 'oras://ghcr.io/lesidon/teannotate-neuralte:1.0',
        terrier_container : 'oras://ghcr.io/lesidon/teannotate-terrier:1.0',
    ]
    return params.containsKey(name) ? params[name] : fallback[name]
}

// ── Auto-bind a working `ps` into every Singularity/Apptainer container ────────
// Nextflow runs `ps` to collect per-task metrics; some images ship a missing or broken
// ps (e.g. rocker/tidyverse -> "libprocps.so.4: cannot open shared object file"), which
// spams the logs and, on this cluster's Nextflow, can abort the task. We detect the host
// `ps` and the procps shared library it needs at config-eval time and emit --bind options
// that drop a working ps into the container. Only the procps library is bound (nothing
// else links it, so no risk of shadowing the container's own libraries) into the standard
// Debian multiarch dir — all pipeline images are Debian-based, and their newer, backward-
// compatible glibc/loader run the (older) host binary without an LD_LIBRARY_PATH change.
// Detection runs on the driver host; under the local executor that IS the compute node.
// Best-effort and memoised: any failure yields '' (no binds). Toggle with --auto_bind_ps;
// --host_ps forces a specific binary.
def hostPsBindOpts() {
    if (!params.auto_bind_ps && !params.host_ps) return ''
    def cached = System.getProperty('teannotate.hostps.binds')
    if (cached != null) return cached
    def result = ''
    try {
        def run = { cmd -> def p = ['bash', '-c', cmd].execute(); p.waitFor(); p.in.text.trim() }
        def ps = (params.host_ps ?: run('command -v ps 2>/dev/null'))
        if (ps && new File(ps.toString()).isFile()) {
            def real  = new File(ps.toString()).canonicalPath
            def binds = ["--bind ${real}:/usr/bin/ps".toString()]
            run("ldd ${real} 2>/dev/null").readLines().each { line ->
                def m = (line =~ /=>\s+(\/\S+)/)
                if (m.find()) {
                    def lib  = m.group(1)
                    def base = new File(lib).name
                    if (base.startsWith('libproc') && new File(lib).isFile())
                        binds << "--bind ${lib}:/usr/lib/x86_64-linux-gnu/${base}".toString()
                }
            }
            result = binds.join(' ')
        }
    } catch (Throwable t) {
        result = ''
    }
    System.setProperty('teannotate.hostps.binds', result)
    return result
}

// ── Resource cap helper (called from conf/base.config) ────────────────────────
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj, params.max_cpus as int) }
        catch (all) { return obj }
    }
}
