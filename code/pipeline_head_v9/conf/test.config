// Minimal test profile. Uses a small fungal genome to exercise
// organism routing, FASTA validation, and genome_stats in CI.
//
// Test genome: Neurospora crassa OR74A chr7 first 1 Mb subset.
// Download instructions: see tests/test_data/README.md

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function (genome_stats + input_check)'

    // Resource caps — keep CI fast
    max_cpus   = 4
    max_memory = '12.GB'
    max_time   = '1.h'

    // Input
    input            = "${projectDir}/assets/test_samplesheet.csv"
    outdir           = 'test_results'

    // Organism type comes from the samplesheet (fungus); exercise the N50
    // assembly-quality heuristic here.
    assembly_quality = 'auto'      // exercises N50 heuristic

    // Stage 4 visualization is implemented; exercise it end-to-end in the test.
    // (Set --skip_visualization to bypass on very large runs.)
    skip_visualization     = false
}
