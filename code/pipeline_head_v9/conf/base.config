// Base process resource configuration.
// check_max() is defined in nextflow.config and caps values at params.max_*.

process {
    cpus   = { check_max( 1,                    'cpus'   ) }
    memory = { check_max( 6.GB * task.attempt,  'memory' ) }
    time   = { check_max( 4.h  * task.attempt,  'time'   ) }

    // HPC queue and extra directives — set via --queue / --clusterOptions at runtime.
    // Evaluated lazily (closure) so profile overrides are respected at job submission.
    queue          = { params.queue          ?: null }
    clusterOptions = { params.clusterOptions ?: null }

    // Retry on common OOM / walltime exit codes
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // ── Resource labels ───────────────────────────────────────────────────────

    withLabel: process_single {
        cpus   = { check_max( 1,                     'cpus'   ) }
        memory = { check_max( 6.GB  * task.attempt,  'memory' ) }
        time   = { check_max( 4.h   * task.attempt,  'time'   ) }
    }

    withLabel: process_low {
        cpus   = { check_max( 4,                     'cpus'   ) }
        memory = { check_max( 12.GB * task.attempt,  'memory' ) }
        time   = { check_max( 6.h   * task.attempt,  'time'   ) }
    }

    withLabel: process_medium {
        cpus   = { check_max( 16,                    'cpus'   ) }
        memory = { check_max( 32.GB * task.attempt,  'memory' ) }
        time   = { check_max( 24.h  * task.attempt,  'time'   ) }
    }

    withLabel: process_high {
        cpus   = { check_max( 32,                    'cpus'   ) }
        memory = { check_max( 64.GB * task.attempt,  'memory' ) }
        time   = { check_max( 72.h  * task.attempt,  'time'   ) }
    }

    // TRASH and other satellite tools — very high RAM requirement
    withLabel: process_satellite {
        cpus   = { check_max( 88,                    'cpus'   ) }
        memory = { check_max( 128.GB * task.attempt, 'memory' ) }
        time   = { check_max( 24.h   * task.attempt, 'time'   ) }
    }

    // GPU-accelerated classification (e.g. TEclass2 Transformer model)
    withLabel: process_gpu {
        cpus        = { check_max( 8,                    'cpus'   ) }
        memory      = { check_max( 32.GB * task.attempt, 'memory' ) }
        time        = { check_max( 24.h  * task.attempt, 'time'   ) }
        accelerator = 1
        // GPU jobs route to a dedicated partition when params.gpu_queue is set,
        // falling back to the default queue if not.
        queue       = { params.gpu_queue ?: params.queue ?: null }
    }

    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }

    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 3
    }
}
