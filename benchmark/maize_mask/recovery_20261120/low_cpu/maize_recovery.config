// Keep the declarations of completed tasks unchanged, so their cache hashes match.
// Cached evidence requests64CPUs; Nextflow checks cache before launch resources.
process {
    withName: 'CURATION:TETRIMMER_POSTPROCESS' {
        time = 48.h
    }
    // This remaining high-resource classifier has not completed; fit it to16CPUs.
    withName: 'CURATION:TECLASS2' {
        cpus = 16
    }
}
executor {
    cpus = (System.getenv('SLURM_CPUS_PER_TASK') ?: '16') as int
    memory = 115.GB
}
