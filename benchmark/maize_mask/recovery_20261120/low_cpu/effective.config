process.'withName:TETRIMMER'.containerOptions = {
            if (!(workflow.containerEngine in ['singularity','apptainer'])) return ''
            def teaid = params.containsKey('tetrimmer_teaid_dir') ? params.tetrimmer_teaid_dir : null
            def opts  = ['--writable-tmpfs']
            if (teaid) opts << "--bind ${teaid}:/usr/local/share/tetrimmer/TE-Aid-master"
            return opts.join(' ')
        }
