// Maize recovery only: Nextflow schedules every uncached process separately.
// Keep the successful discovery/evidence/TEtrimmer declarations unchanged.
process {
    executor = 'slurm'
    queue = 'htc'
    clusterOptions = '--exclude=ct[01-10],gn[19,26]'

    // Cache-only stages: fail before scientific work if a cache entry is missing.
    withName: 'INPUT_CHECK|LIBRARY_DEDUP:CD_HIT_EST|LIBRARY_DEDUP:DEDUP_REFINE|TE_EVIDENCE|CURATION:TETRIMMER' {
        executor = 'local'
        beforeScript = 'echo "ERROR: required successful maize cache was not reused" >&2; exit 78'
    }

    withName: 'CURATION:TETRIMMER_POSTPROCESS' {
        queue = 'mem'
        clusterOptions = '--exclude=ct01'
        cpus = 4
        memory = { 32.GB * task.attempt }
        time = 48.h
        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 1
    }
    withName: 'CURATION:CD_HIT_EST_CURATED' {
        cpus = 16
        memory = 32.GB
        time = 24.h
    }
    withName: 'CURATION:DEDUP_REFINE_CURATED' {
        queue = 'mem'
        clusterOptions = '--exclude=ct01'
        cpus = 16
        memory = 64.GB
        time = 72.h
    }
    withName: 'CURATION:DOMAIN_RELABEL' {
        cpus = 4
        memory = 16.GB
        time = 24.h
    }
    withName: 'CURATION:EXTRACT_UNKNOWN' {
        cpus = 1
        memory = 4.GB
        time = 4.h
    }
    withName: 'CURATION:TECLASS2' {
        cpus = 8
        memory = 64.GB
        time = 24.h
    }
    withName: 'CURATION:DEEPTE' {
        cpus = 4
        memory = 16.GB
        time = 24.h
    }
    withName: 'CURATION:CREATE' {
        cpus = 8
        memory = 32.GB
        time = 24.h
    }
    withName: 'CURATION:NEURALTE' {
        cpus = 8
        memory = 32.GB
        time = 24.h
    }
    withName: 'CURATION:TERRIER' {
        cpus = 4
        memory = 16.GB
        time = 24.h
    }
    withName: 'CURATION:ENSEMBLE_VOTE' {
        cpus = 1
        memory = 8.GB
        time = 4.h
    }
    withName: 'FINAL_LIBRARY' {
        cpus = 1
        memory = 4.GB
        time = 4.h
    }
}
executor.queueSize = 4
