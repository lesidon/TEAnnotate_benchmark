// Maize-only operational overrides. Preserve every scientific option and cached input.
process {
    withName: 'CURATION:TETRIMMER_POSTPROCESS' {
        time = 48.h
    }
}
executor {
    cpus = (System.getenv('SLURM_CPUS_PER_TASK') ?: '32') as int
    // Keep concurrent local tasks within the requested 128-GB allocation.
    memory = 115.GB
}
