// trace_raw.config - library-stage runs of the ablation: CPU-hours per task (raw ms)
trace.overwrite = true
trace.fields = 'task_id,name,status,exit,cpus,memory,realtime,duration,%cpu,peak_rss'
trace.raw = true
// the local executor must see the whole allocation: on some nodes it saw only 8 of 16 CPUs
// and refused CD_HIT_EST (16 CPUs), failing every combination of Septoria and C. elegans
executor { cpus = (System.getenv('SLURM_CPUS_PER_TASK') ?: '16') as int }
// 2026-10-23: CD-HIT-EST on ~11k rice consensi ran past the 1-day process_medium limit
// (earlgrey+edta+heliano+hite); the library stages of large plant libraries need longer
process {
    withName: 'CD_HIT_EST'   { time = 5.d }
    withName: 'DEDUP_REFINE' { time = 5.d }
    withName: 'TE_EVIDENCE'  { time = 5.d }
}
