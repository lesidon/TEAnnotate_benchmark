// ablation.config - resources for discover_one.nf. Earl Grey and HELIANO use the existing
// Conda environments of the pipeline runs (the v10 ymls differ from v9's only in the
// channel list, 'defaults' -> 'nodefaults'; the pinned tool versions are identical), so
// nothing is built on the offline compute nodes. The executor sees the whole allocation.
def CC = '/trinity/home/leonid.sidorov/tmp/teannotate_benchmark/whole_pipeline_benchmark/work/conda_cache'
executor { cpus = (System.getenv('SLURM_CPUS_PER_TASK') ?: '16') as int }
process {
    withName: 'HITE'     { cpus = 16; time = 5.d }
    withName: 'EARLGREY' { conda = "${CC}/env-e8cd3caef48f718c-8aca2d793016020c698f928e1801d622"; time = 5.d }
    withName: 'HELIANO'  { conda = "${CC}/env-396bba1bf383eb7f-60c88da8327f5fcc226707cfad5f6d13"; time = 5.d }
    withName: 'EDTA'     { time = 5.d }
}
conda.createTimeout = '3 h'
trace.overwrite = true   // a resumed run rewrites its trace (the cached task keeps its realtime)
// compute cost: allocated cpus x realtime = CPU-hours; raw = ms and bytes, for parsing
trace.fields = 'task_id,name,status,exit,cpus,memory,realtime,duration,%cpu,peak_rss,rchar,wchar'
trace.raw = true
