// Rerun-from-HiTE (2026-09-24) for the ORIGINAL pipeline checkout, used unmodified.
// HITE only: cache=false forces it (and everything downstream) to rerun, and the
// restored LtrDetector is bound in so HiTE's default FiLTR LTR step works - see
// hite_patch/README.txt. Upstream (INPUT_CHECK, GENOME_STATS, ASSESS, EDTA, HELIANO)
// keeps its July hash and is reused from cache.
process {
    withName: 'HITE' {
        cache            = false
        containerOptions = '--writable-tmpfs --bind /trinity/home/leonid.sidorov/tmp/teannotate_benchmark/whole_pipeline_benchmark/hite_clone/bin/FiLTR-main/bin/LtrDetector:/HiTE/bin/FiLTR-main/bin/LtrDetector'
    }
}
