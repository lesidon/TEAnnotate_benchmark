// 2026-09-28 restart for the ORIGINAL pipeline checkout, used unmodified.
// HITE: restored LtrDetector (FiLTR on); plant genome, HiTE's default plant=1 is right. See hite_patch/README.txt.
//       (--max_cpus differs from July, so HiTE gets a new hash and is not reused.)
// REPEATMASKER: writable host copy of RepeatMasker's Libraries bound over the image's, so
//       its general-library build works on fuse-overlay nodes (fixed in 921720f).
process {
    withName: 'HITE' {
        containerOptions = '--writable-tmpfs --bind /trinity/home/leonid.sidorov/tmp/teannotate_benchmark/whole_pipeline_benchmark/hite_clone/bin/FiLTR-main/bin/LtrDetector:/HiTE/bin/FiLTR-main/bin/LtrDetector'
    }
    withName: 'REPEATMASKER' {
        containerOptions = '--writable-tmpfs --bind /trinity/home/leonid.sidorov/tmp/teannotate_benchmark/whole_pipeline_benchmark/rm_libraries/oryza_sativa:/opt/RepeatMasker/Libraries'
    }
}
