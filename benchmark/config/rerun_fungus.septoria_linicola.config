// 2026-09-28 fungal run for the ORIGINAL pipeline checkout, used unmodified.
// HITE: restored LtrDetector (FiLTR on) + main.py with default plant=0 (fungus); see
//       hite_patch/README.txt.
// REPEATMASKER: writable host copy of RepeatMasker's Libraries bound over the image's, so
//       its general-library build works on fuse-overlay nodes (the checkout's module
//       predates the -libdir fix, 921720f).
process {
    withName: 'HITE' {

        containerOptions = '--writable-tmpfs --bind /trinity/home/leonid.sidorov/tmp/teannotate_benchmark/whole_pipeline_benchmark/hite_clone/bin/FiLTR-main/bin/LtrDetector:/HiTE/bin/FiLTR-main/bin/LtrDetector --bind /trinity/home/leonid.sidorov/tmp/teannotate_benchmark/whole_pipeline_benchmark/hite_patch/nonplant_filtr/main.py:/HiTE/main.py'
    }
    withName: 'REPEATMASKER' {
        containerOptions = '--writable-tmpfs --bind /trinity/home/leonid.sidorov/tmp/teannotate_benchmark/whole_pipeline_benchmark/rm_libraries/septoria_linicola:/opt/RepeatMasker/Libraries'
    }
}
