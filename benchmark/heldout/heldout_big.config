// held-out large genomes (rice, maize, zebrafish, human): heldout_eg5d.config plus
//  - the local executor sized from the Slurm allocation: the mouse run saw only 40 of its
//    64 CPUs, so HiTE (16) and Earl Grey (32) could not run together and Earl Grey waited
//    1.8 days for HiTE;
//  - 5-day limits on every long discovery / curation task (v9's process_high limit is 72 h).
executor { cpus = (System.getenv('SLURM_CPUS_PER_TASK') ?: '32') as int }
process { withName: 'HITE'      { cpus = 16; time = 5.d } }
process { withName: 'EARLGREY'  { time = 5.d } }
process { withName: 'EDTA'      { time = 5.d } }
process { withName: 'HELIANO'   { time = 5.d } }
process { withName: 'TETRIMMER' { time = 5.d } }
conda.createTimeout = '3 h'
